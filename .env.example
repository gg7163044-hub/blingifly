# Server-side only. Never prefix secrets with NEXT_PUBLIC_.
# Get an API key from the provider dashboard.
GEMINI_API_KEY=
# Default model is a Gemini image-generation model; check current availability in your provider dashboard.
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# Optional app origin for production CORS/origin validation. Example: https://blingifly.vercel.app
APP_ORIGIN=
# Request size guard, in bytes. Defaults to 4 MiB.
MAX_UPLOAD_BYTES=4194304
